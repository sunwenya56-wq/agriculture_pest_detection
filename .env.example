# 复制为 .env 后填写。切勿把真实 Key 提交到仓库。
AGRI_ENV=dev

# LLM 通道：cloud（云端 API）/ local（本地 Qwen + LoRA adapter）/ auto（有云端 Key 优先云端，否则本地）
AGRI_LLM_BACKEND=auto

AGRI_QWEN_API_KEY=
AGRI_QWEN_BASE_URL=https://api.siliconflow.cn/v1
AGRI_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
AGRI_QWEN_TIMEOUT_S=30
AGRI_QWEN_MAX_TOKENS=1000
AGRI_QWEN_TEMPERATURE=0.7
AGRI_QWEN_RETRIES=3

# 本地通道（P4 LoRA 微调产物）
AGRI_LOCAL_MODEL_PATH=models/Qwen2.5-7B-Instruct
AGRI_LOCAL_ADAPTER_PATH=models/qwen_agri_lora
AGRI_LOCAL_DEVICE=auto

# 推理
AGRI_DEVICE=auto
AGRI_IMGSZ=640
AGRI_CONFIDENCE=0.25
AGRI_IOU=0.15
AGRI_MAX_DET=50
AGRI_DETECTION_INTERVAL_S=1.0
AGRI_BATCH_WORKERS=1

# 存储与日志
AGRI_MODELS_DIR=models
AGRI_EXPORT_DIR=exports
AGRI_LOG_DIR=logs
AGRI_DB_PATH=history.db
AGRI_LOG_LEVEL=INFO
AGRI_ADVICE_CACHE_TTL_S=86400

# 语音播报
AGRI_TTS_ENABLED=false
AGRI_TTS_VOICE=zh-CN-XiaoxiaoNeural
AGRI_TTS_RATE=+0%
